{{! 404 page: rendered as 404.html when "create404page" is enabled in config.json → renderer. }}
{{> head}}
{{> navbar}}
<main class="site-main" id="main">
   <article class="text-page" data-template="404">
      <header class="text-page__header">
         <h1 class="text-page__title">{{ translate 'error.404' }}</h1>
      </header>
      <div class="entry">
         <p>{{ translate 'error.message' }}</p>
         <p><a href="{{@website.url}}">{{ translate 'error.button' }}</a></p>
      </div>
   </article>
</main>
{{> footer}}
