{{! Tag page: News posts with one tag (e.g. "Exhibition"). }}
{{> head}}
{{> navbar}}
<main class="site-main" id="main">
   <div class="news" data-template="tag">
      {{#tag}}
         <header class="text-page__header">
            <p class="news__kicker">{{ translate 'tag.postsTagged' }}</p>
            <h1 class="text-page__title">{{name}}</h1>
            {{#if description}}<div class="entry news__intro">{{{description}}}</div>{{/if}}
         </header>
      {{/tag}}

      {{> post-list}}
   </div>
</main>
{{> footer}}
