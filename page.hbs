{{! Default page template: About / Bio / CV, Contact and any other text page.
    Everything shown comes from the page editor: title, optional featured image, and body. }}
{{> head}}
{{> navbar}}
<main class="site-main" id="main">
   {{#page}}
      <article class="text-page" data-template="page">

         <header class="text-page__header">
            <h1 class="text-page__title">{{title}}</h1>
         </header>

         {{#featuredImage}}
            {{#if url}}
               <figure class="text-page__image">
                  <img
                     src="{{url}}"
                     {{#if @config.site.responsiveImages}}
                        {{!-- sizes: the text column is at most 42rem (672px) wide --}}
                        {{responsiveImageAttributes 'featuredImage' srcset "(max-width: 720px) 100vw, 672px"}}
                     {{/if}}
                     {{lazyload "eager"}}
                     height="{{height}}"
                     width="{{width}}"
                     alt="{{alt}}">
                  {{#checkIfAny caption credits}}
                     <figcaption>{{caption}} {{credits}}</figcaption>
                  {{/checkIfAny}}
               </figure>
            {{/if}}
         {{/featuredImage}}

         <div class="entry">
            {{{text}}}
         </div>

      </article>
   {{/page}}
</main>
{{> footer}}
