{{! Front page. If a Portfolio page is chosen in Theme settings → Portfolio, show its series as a grid;
    otherwise fall back to a simple list of the latest posts. }}
{{> head}}
{{> navbar}}
<main class="site-main" id="main">
   <div class="home" data-template="home">
      <h1 class="visually-hidden">{{@website.name}}</h1>

      {{#if @config.custom.homeIntro}}
         {{! the intro may contain <br> for a line break (plain line breaks are lost when HTML compression is on) }}
         <p class="home__intro">{{{@config.custom.homeIntro}}}</p>
      {{/if}}

      {{#if @config.custom.portfolioPage}}
         {{! getPages accepts the page ID as a string or number; its context is that page, so the partial reads its subpages }}
         <div class="home__portfolio">{{#getPages (concatenate @config.custom.portfolioPage) "" ""}}
            {{> series-grid}}
         {{/getPages}}</div>
         <div class="home__fallback">{{> post-list}}</div>
      {{else}}
         {{> post-list}}
      {{/if}}

   </div>
</main>
{{> footer}}
