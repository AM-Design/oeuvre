{{! Single post: used for News (exhibitions, events, announcements). Full News design comes in Phase 4. }}
{{> head}}
{{> navbar}}
<main class="site-main" id="main">
   {{#post}}
      <article class="text-page post" data-template="post">

         <header class="text-page__header">
            <h1 class="text-page__title">{{title}}</h1>
            <time class="post__date" datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{date createdAt}}</time>
         </header>

         {{#featuredImage}}
            {{#if url}}
               <figure class="text-page__image">
                  <img
                     src="{{url}}"
                     {{#if @config.site.responsiveImages}}
                        {{!-- sizes: the text column is at most 42rem (672px) wide --}}
                        {{responsiveImageAttributes 'featuredImage' srcset "(max-width: 720px) 100vw, 672px"}}
                     {{/if}}
                     {{lazyload "eager"}}
                     height="{{height}}"
                     width="{{width}}"
                     alt="{{alt}}">
                  {{#checkIfAny caption credits}}
                     <figcaption>{{caption}} {{credits}}</figcaption>
                  {{/checkIfAny}}
               </figure>
            {{/if}}
         {{/featuredImage}}

         <div class="entry">
            {{{text}}}
         </div>

         {{#if tags}}
            <ul class="post__tags">
               {{#each tags}}
                  <li><a href="{{url}}">{{name}}</a></li>
               {{/each}}
            </ul>
         {{/if}}

      </article>

      {{!-- previousPost / nextPost belong to the page context, one level above the post block --}}
      {{#checkIfAny ../previousPost ../nextPost}}
         <nav class="post-nav" aria-label="{{ translate 'post.navLabel' }}">
            {{#../previousPost}}
               <a class="post-nav__prev" href="{{url}}" rel="prev">
                  <span class="post-nav__label">← {{ translate 'post.previousPost' }}</span>
                  <span class="post-nav__title">{{title}}</span>
               </a>
            {{/../previousPost}}
            {{#../nextPost}}
               <a class="post-nav__next" href="{{url}}" rel="next">
                  <span class="post-nav__label">{{ translate 'post.nextPost' }} →</span>
                  <span class="post-nav__title">{{title}}</span>
               </a>
            {{/../nextPost}}
         </nav>
      {{/checkIfAny}}
   {{/post}}
</main>
{{> footer}}
