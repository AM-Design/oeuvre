<footer class="site-footer">

   {{! optional signature emblem: Theme → Custom settings → Footer }}
   {{#if @config.custom.signatureMark}}
      <span class="site-footer__mark">
         <img src="{{@config.custom.signatureMark}}" alt="{{@config.custom.signatureAlt}}" loading="lazy">
      </span>
   {{/if}}

   {{! footer menu, managed in Menus → assigned to the "Footer menu" position }}
   {{#if menus.footerMenu}}
      {{> menu menus.footerMenu}}
   {{/if}}

   {{! social profile links, set in Theme settings → Social links }}
   {{#checkIfAny @config.custom.socialInstagram @config.custom.socialFacebook}}
      <ul class="social-links">
         {{#if @config.custom.socialInstagram}}
            <li><a href="{{@config.custom.socialInstagram}}" rel="me noopener" target="_blank">{{ translate 'partials.footer.instagram' }}</a></li>
         {{/if}}
         {{#if @config.custom.socialFacebook}}
            <li><a href="{{@config.custom.socialFacebook}}" rel="me noopener" target="_blank">{{ translate 'partials.footer.facebook' }}</a></li>
         {{/if}}
      </ul>
   {{/checkIfAny}}

   {{#if @config.custom.footerText}}
      <p class="site-footer__text">{{@config.custom.footerText}}</p>
   {{/if}}

</footer>

<script async src="{{js "scripts.js"}}"></script>

{{{@footerCustomCode}}}

{{{ publiiFooter }}}

</body>
</html>
