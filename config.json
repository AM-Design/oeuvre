{
    "name": "Oeuvre",
    "version": "1.0.0",
    "author": "Adeeb Missaghi - AdeebMDesign",
    "renderer": {
        "relatedPostsNumber": 3,
        "renderRelatedPosts": false,
        "renderSimilarPosts": false,
        "renderPrevNextPosts": true,
        "createContentStructure": true,
        "includeFeaturedInPosts": true,
        "tagsIncludeFeaturedInPosts": true,
        "authorsIncludeFeaturedInPosts": false,
        "featuredPostsNumber": 0,
        "tagsFeaturedPostsNumber": 0,
        "authorsFeaturedPostsNumber": 0,
        "createTagPages": true,
        "createAuthorPages": false,
        "createTagsList": false,
        "create404page": true,
        "createSearchPage": false
    },
    "supportedFeatures": {
        "blockEditor": true,
        "tagsList": false,
        "tagPages": true,
        "tagImages": false,
        "authorPages": false,
        "authorImages": false,
        "searchPage": false,
        "errorPage": true,
        "customSearch": false,
        "customComments": false,
        "embedConsents": true,
        "pages": true,
        "postsPage": true
    },
    "menus": {
        "mainMenu": "Main menu",
        "footerMenu": "Footer menu"
    },
    "pageTemplates": {
        "series": "Series (artwork gallery)",
        "portfolio": "Portfolio (grid of sub-pages)"
    },
    "config": [
        {
            "name": "postsPerPage",
            "label": "Posts per page (News)",
            "value": 12,
            "type": "number"
        },
        {
            "name": "tagsPostsPerPage",
            "label": "Posts per tag page",
            "value": 12,
            "type": "number"
        },
        {
            "name": "excerptLength",
            "label": "Excerpt length (words, News list)",
            "value": 25,
            "type": "number"
        },
        {
            "name": "logo",
            "label": "Website logo",
            "value": "",
            "type": "upload",
            "upload": true
        }
    ],
    "customConfig": [
        {
            "name": "separator",
            "type": "separator",
            "label": "Home page",
            "group": "Portfolio",
            "size": "small"
        },
        {
            "name": "portfolioPage",
            "label": "Portfolio page",
            "group": "Portfolio",
            "note": "The page that holds your series as sub-pages (e.g. \"Work\"). Its published sub-pages appear on the home page, in the order set in Pages → Edit hierarchy.",
            "value": "",
            "type": "pages-dropdown"
        },
        {
            "name": "homeIntro",
            "label": "Home page introduction",
            "group": "Portfolio",
            "note": "Optional line shown above the series grid. Type <br> where you want a line break.",
            "value": "",
            "type": "textarea"
        },
        {
            "name": "homeColumns",
            "label": "Series per row",
            "group": "Portfolio",
            "note": "On large screens. Phones show one or two per row.",
            "value": "3",
            "type": "select",
            "options": [
                {
                    "label": "2",
                    "value": "2"
                },
                {
                    "label": "3",
                    "value": "3"
                },
                {
                    "label": "4",
                    "value": "4"
                }
            ]
        },
        {
            "name": "coverStyle",
            "label": "Series covers",
            "group": "Portfolio",
            "note": "How cover images appear on the home and Work pages.",
            "value": "crop",
            "type": "select",
            "options": [
                {
                    "label": "Square, title on the image (like the original site)",
                    "value": "crop"
                },
                {
                    "label": "Whole image, title underneath",
                    "value": "whole"
                }
            ]
        },
        {
            "name": "socialInstagram",
            "label": "Instagram profile URL",
            "group": "Social links",
            "value": "",
            "type": "text",
            "placeholder": "https://www.instagram.com/…"
        },
        {
            "name": "socialFacebook",
            "label": "Facebook profile URL",
            "group": "Social links",
            "value": "",
            "type": "text",
            "placeholder": "https://www.facebook.com/…"
        },
        {
            "name": "footerText",
            "label": "Footer text",
            "group": "Footer",
            "note": "E.g. © 2026 Your Name. All rights reserved.",
            "value": "",
            "type": "text"
        },
        {
            "name": "signatureMark",
            "label": "Signature emblem",
            "group": "Footer",
            "note": "Optional small image shown in the footer, e.g. the graphic that marks your artwork.",
            "value": "",
            "type": "upload",
            "upload": true
        },
        {
            "name": "signatureAlt",
            "label": "Emblem description",
            "group": "Footer",
            "note": "Describes the emblem for screen readers, e.g. \"Jane Doe's signature emblem\".",
            "value": "",
            "type": "text"
        },
        {
            "name": "newsTitle",
            "label": "News page title",
            "group": "News",
            "note": "Heading of the News page. The page's address is set in Site settings → URLs → Post prefix (e.g. news).",
            "value": "News",
            "type": "text"
        },
        {
            "name": "newsIntro",
            "label": "News page introduction",
            "group": "News",
            "note": "Optional line under the heading.",
            "value": "",
            "type": "textarea"
        },
        {
            "name": "layout",
            "label": "Layout",
            "group": "Look",
            "note": "Sidebar: logo and menu in a column on the left, like the original site. On phones both layouts use a Menu button.",
            "value": "sidebar",
            "type": "select",
            "options": [
                {
                    "label": "Sidebar on the left (like the original site)",
                    "value": "sidebar"
                },
                {
                    "label": "Menu across the top",
                    "value": "topbar"
                }
            ]
        },
        {
            "name": "accentColor",
            "label": "Accent colour",
            "group": "Look",
            "note": "Current menu item, hover states and the quote rule. Links use a darker shade of it automatically so they stay readable.",
            "value": "#ed5448",
            "type": "colorpicker"
        },
        {
            "name": "headingFont",
            "label": "Heading font",
            "group": "Look",
            "note": "Titles, headings and the menu.",
            "value": "montserrat",
            "type": "select",
            "options": [
                {
                    "label": "Montserrat (like the original site)",
                    "value": "montserrat"
                },
                {
                    "label": "Book serif (Iowan / Palatino)",
                    "value": "book"
                },
                {
                    "label": "Classic serif (Georgia)",
                    "value": "classic"
                },
                {
                    "label": "System sans-serif",
                    "value": "sans"
                }
            ]
        },
        {
            "name": "bodyFont",
            "label": "Text font",
            "group": "Look",
            "value": "montserrat",
            "type": "select",
            "options": [
                {
                    "label": "Montserrat (like the original site)",
                    "value": "montserrat"
                },
                {
                    "label": "System sans-serif",
                    "value": "sans"
                }
            ]
        },
        {
            "name": "uppercase",
            "label": "Capital letters for headings and menu",
            "group": "Look",
            "note": "Like the original site.",
            "value": true,
            "type": "checkbox"
        },
        {
            "name": "fontSize",
            "label": "Text size",
            "group": "Look",
            "note": "1 = normal. Scales all text.",
            "value": "1",
            "type": "range",
            "min": 0.9,
            "max": 1.3,
            "step": 0.05
        },
        {
            "name": "mainWidth",
            "label": "Maximum content width",
            "group": "Look",
            "note": "CSS width, e.g. 1200px.",
            "value": "1200px",
            "type": "text"
        },
        {
            "name": "faviconUpload",
            "label": "Upload favicon file",
            "group": "Additional",
            "note": "The ideal size of a favicon is 16x16 pixels. Save your favicon as either favicon.png or favicon.ico",
            "value": "",
            "type": "smallupload",
            "upload": true
        },
        {
            "name": "faviconExtension",
            "label": "Favicon extension",
            "group": "Additional",
            "value": "image/x-icon",
            "type": "select",
            "options": [
                {
                    "label": ".ico",
                    "value": "image/x-icon"
                },
                {
                    "label": ".png",
                    "value": "image/png"
                }
            ]
        }
    ],
    "authorConfig": [],
    "postConfig": [],
    "pageConfig": [
        {
            "name": "seriesLayout",
            "label": "Artwork layout",
            "note": "Series template only. Gallery wall: each work with space around it and its label beside it, like a museum wall. Grid: all works in rows.",
            "value": "wall",
            "type": "select",
            "pageTemplates": "series",
            "options": [
                {
                    "label": "Gallery wall (one work at a time, label beside it)",
                    "value": "wall"
                },
                {
                    "label": "Grid",
                    "value": "grid"
                }
            ]
        },
        {
            "name": "captionDisplay",
            "label": "Artwork captions",
            "note": "Series template only. Captions always appear in the enlarged view.",
            "value": "below",
            "type": "select",
            "pageTemplates": "series",
            "options": [
                {
                    "label": "Show under each image",
                    "value": "below"
                },
                {
                    "label": "Only in the enlarged view",
                    "value": "lightbox"
                }
            ]
        }
    ],
    "tagConfig": [],
    "files": {
        "ignoreAssets": [
            "scss",
            ".DS_Store"
        ],
        "assetsPath": "assets",
        "partialsPath": "partials",
